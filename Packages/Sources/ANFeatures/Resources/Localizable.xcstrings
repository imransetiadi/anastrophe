    },
    "add.confirm.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure this is your building, then hold your access card near the top of your iPhone."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan ini gedung Anda, lalu tempelkan kartu akses ke bagian atas iPhone."
