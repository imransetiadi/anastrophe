          }
        }
      }
    },
    "help.section.faq": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frequently asked questions"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pertanyaan umum"
          }
        }
      }
    },
    "help.section.support": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Support"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dukungan"
          }
        }
      }
    },
    "help.support.text": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For cards and building access, contact your building management."
          }
        },
        "id": {
