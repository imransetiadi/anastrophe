    "add.code.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "8 letters and numbers from your building management, for example on a lobby poster."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "8 huruf dan angka dari pengelola gedung, misalnya di poster lobi."
