    "add.error.reader_unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone can't read physical cards."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone ini tidak bisa membaca kartu fisik."
          }
        }
      }
    },
    "add.error.service_unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service isn't available yet. Try again later."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layanan belum tersedia. Coba lagi nanti."
          }
        }
      }
    },
    "add.error.site_channel_unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The access methods your building allows aren't available on this iPhone yet. Contact your building management."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cara akses yang diizinkan gedung ini belum tersedia di iPhone ini. Hubungi pengelola gedung."
          }
        }
      }
    },
    "add.error.site_channels_not_offered": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The access methods your building allows aren't available yet. Contact your building management."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cara akses yang diizinkan gedung ini belum tersedia. Hubungi pengelola gedung."
          }
        }
      }
    },
    "add.error.site_code_unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We don't recognize this building code. Check the code from your building management."
