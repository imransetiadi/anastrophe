    "add.method.invitation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use an invitation link"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakai tautan undangan"
          }
        }
      }
    },
    "add.method.invitation.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From a message or email sent by your building management."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dari pesan atau email pengelola gedung."
          }
        }
      }
    },
    "add.pending.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your building management needs to approve this iPhone. After approval, add the card again by tapping the same card, or ask your building management for an invitation link."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengelola gedung perlu menyetujui iPhone ini. Setelah disetujui, tambahkan kartu lagi dengan menempelkan kartu yang sama, atau minta tautan undangan dari pengelola."
          }
        }
      }
    },
    "add.pending.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for approval"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menunggu persetujuan"
          }
        }
      }
    },
    "add.read.multiple": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More than one card detected. Hold just one card."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terdeteksi lebih dari satu kartu. Tempelkan satu kartu saja."
