    "add.error.channel_unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This feature isn't available on your device or in your region yet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Fitur ini belum tersedia di perangkat atau wilayah Anda."
          }
        }
      }
    },
    "add.error.generic": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong. Try again."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terjadi kesalahan. Coba lagi."
          }
        }
