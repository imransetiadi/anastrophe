          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartu ini sudah punya beberapa permintaan yang menunggu pengelola gedung. Hubungi pengelola gedung."
          }
        }
      }
    },
    "enroll.error.site_unsupported": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This building doesn't support adding cards with a physical card yet. Ask your building management for an invitation link."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gedung ini belum memakai pendaftaran dengan kartu fisik. Minta tautan undangan dari pengelola gedung."
          }
        }
      }
    },
    "help.channel.available": {
