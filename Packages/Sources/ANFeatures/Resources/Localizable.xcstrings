    },
    "add.code.invalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The building code has 8 letters and numbers."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kode gedung terdiri dari 8 huruf dan angka."
