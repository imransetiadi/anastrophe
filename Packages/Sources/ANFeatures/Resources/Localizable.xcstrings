        }
      }
    },
    "add.confirm.read": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap card"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempel kartu"
          }
        }
      }
    },
    "add.confirm.wrong_site": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not my building"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
