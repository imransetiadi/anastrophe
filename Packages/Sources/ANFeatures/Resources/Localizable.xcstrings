    "add.error.offline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This step needs an internet connection."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Butuh koneksi internet untuk langkah ini."
          }
        }
      }
