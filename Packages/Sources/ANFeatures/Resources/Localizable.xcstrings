      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Setting up your card…"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyiapkan kartu…"
          }
        }
      }
    },
    "card.reason.bluetooth_denied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anastrophe isn't allowed to use Bluetooth. Allow it in Settings."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anastrophe belum diizinkan memakai Bluetooth. Izinkan di Pengaturan."
          }
        }
      }
    },
    "card.reason.bluetooth_off": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth is off. Turn on Bluetooth to use this card."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth mati. Nyalakan Bluetooth untuk memakai kartu ini."
          }
        }
      }
    },
    "card.reason.expired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This card's certificate has expired and can't renew automatically. Add the card again."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sertifikat kartu ini kedaluwarsa dan tidak bisa diperbarui otomatis. Tambahkan ulang kartu."
          }
        }
      }
    },
    "card.reason.needs_transfer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This card needs to be moved to this iPhone before you can use it."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartu ini perlu dipindahkan ke iPhone ini sebelum bisa dipakai."
          }
        }
      }
    },
    "card.reason.no_channel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This building's access method isn't available on your iPhone or in your region yet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cara akses gedung ini belum tersedia di iPhone atau wilayah Anda."
          }
        }
      }
    },
    "card.reason.pending_approval": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This card is waiting for approval from your building operator."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartu ini menunggu persetujuan pengelola gedung."
          }
        }
      }
    },
    "card.reason.revoked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This card has been revoked and can no longer be used."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartu ini sudah dicabut dan tidak bisa dipakai lagi."
          }
        }
      }
    },
    "card.reason.suspended": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your building operator has suspended this card."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartu ini sedang ditangguhkan oleh pengelola gedung."
          }
        }
      }
    },
    "card.renewal_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This card renews automatically the next time you use it. Make sure your iPhone is connected to the internet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartu ini diperbarui otomatis saat dipakai berikutnya. Pastikan iPhone terhubung ke internet."
          }
        }
      }
    },
    "card.renewal_offline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Internet connection needed. This card must be renewed: connect your iPhone to the internet, then use the card."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perlu terhubung ke internet. Kartu ini harus diperbarui: sambungkan iPhone ke internet, lalu gunakan kartu."
          }
        }
      }
    },
